# ── Always required ───────────────────────────────────────────────────────────
# Anthropic API key — the ONLY credential needed for daily trading operation
ANTHROPIC_API_KEY=sk-ant-...

# ── One-time setup only ───────────────────────────────────────────────────────
# Robinhood Agentic Trading token — needed ONCE to run init_agent.py.
# After setup the token lives in an Anthropic vault; remove this line.
#
# How to get this token:
#   1. Open the Robinhood app → Account → Settings → Agentic Trading
#   2. Enable Agentic Trading for account ••••4423
#   3. Copy the API token shown (it's an OAuth Bearer token)
#   4. Paste it here, run:  python smallcap/setup/init_agent.py
#   5. Delete this line from .env — it's now safely stored in the vault
#
ROBINHOOD_API_TOKEN=your_robinhood_agentic_token_here

# ── Optional overrides ────────────────────────────────────────────────────────
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ── Always required ───────────────────────────────────────────────────────────
# Your Anthropic API key — the ONLY credential needed in most cases.
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Robinhood token (only if Managed Agent auth fails) ──────────────
#
# The Robinhood Agentic Trading OAuth token is managed by Anthropic's
# infrastructure when you connect Robinhood to Claude Code. It is NOT
# visible in the standard Robinhood app settings.
#
# In most cases you DO NOT need this — the Managed Agent sessions use
# Anthropic's existing OAuth connection to your Robinhood account automatically.
#
# Only needed if sessions report Robinhood authentication errors AND you can
# obtain the token via one of these paths:
#   • Desktop Claude Code (Mac): ~/Library/Application Support/Claude/
#   • Contact Robinhood for programmatic Agentic Trading API access
#   • Robinhood website → Settings → Agentic Trading (may appear in future updates)
#
# If you have it: run   python smallcap/setup/init_agent.py --with-vault
#
# ROBINHOOD_API_TOKEN=your_robinhood_agentic_oauth_token

# ── Optional overrides ────────────────────────────────────────────────────────
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Telegram notifications (optional — alerts when trades execute)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
